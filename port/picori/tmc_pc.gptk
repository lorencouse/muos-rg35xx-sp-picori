[controls]
a = x
b = z
x = c
y = f6

l1 = a
r1 = s
l2 = home
r2 = tab

start = enter
back = backspace
guide = f8

up = up
down = down
left = left
right = right

left_analog_up = up
left_analog_down = down
left_analog_left = left
left_analog_right = right

